# API base URL (used by the proxy service)
REACT_APP_API_BASE_URL=https://api.example.com

# Example auth token referenced in widget API configs as ${env.REACT_APP_TOKEN}
REACT_APP_TOKEN=your-bearer-token-here

# Example API key referenced as ${env.REACT_APP_API_KEY}
REACT_APP_API_KEY=your-api-key-here
